{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/wang/.config/fastfetch/schema4.txt"
  },
  "modules": [
    "break",
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────────── System ──────────────────────────┐"
    },
    {
      "type": "os",
      "key": "  OS"
    },
    {
      "type": "title",
      "key": "  User/Host"
    },
    {
      "type": "kernel",
      "key": "  Kernel"
    },
    {
      "type": "packages",
      "key": "  Packages"
    },
    {
      "type": "shell",
      "key": "  Shell"
    },
    {
      "type": "terminal",
      "key": "  Terminal"
    },
    {
      "type": "terminalfont",
      "key": "  Terminal Font"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────── Desktop Environment ───────────────────┐"
    },
    {
      "type": "lm",
      "key": "  Display Manager"
    },
    {
      "type": "wm",
      "key": "  Window Manager"
    },
    {
      "type": "custom",
      "key": "  Window Manager Theme",
      "key-color": "#CB96E9",
      "format": "Dracula"
    },
    {
      "type": "theme",
      "key": "  Theme"
    },
    {
      "type": "font",
      "key": "  Font"
    },
    {
      "type": "cursor",
      "key": "  Cursor"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌───────────────────────── Hardware ─────────────────────────┐"
    },
    {
      "type": "host",
      "key": "  PC"
    },
    {
      "type": "cpu",
      "key": "  CPU"
    },
    {
      "type": "gpu",
      "key": "  GPU"
    }, 
    {
      "type": "display",
      "key": "  Display ({index})" 
    },
    {
      "type": "memory",
      "key": "  Memory"
    },
    {
      "type": "swap",
      "key": "  Swap"
    },
    {
      "type": "disk",
      "key": "  Disk ({mountpoint})"
    },
    {
      "type": "battery",
      "key": "  Battery ({name})"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌─────────────────────── Age / Uptime ───────────────────────┐"
    },
    {
      "type": "command",
      "key": "  OS Age ",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "  Uptime ",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
